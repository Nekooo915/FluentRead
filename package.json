{
  "name": "fluentread-lite",
  "description": "Lightweight personal Chrome/Edge bilingual translation extension (full-page translation, floating ball, video subtitles).",
  "private": true,
  "version": "0.0.42",
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "node scripts/testing/run-resource-safe.mjs -- wxt build",
    "build:edge": "node scripts/testing/run-resource-safe.mjs -- wxt build -b edge",
    "zip": "node scripts/testing/run-resource-safe.mjs -- wxt zip",
    "zip:edge": "node scripts/testing/run-resource-safe.mjs -- wxt zip -b edge",
    "compile": "node scripts/testing/run-typecheck.mjs",
    "test": "node scripts/testing/run-resource-safe.mjs -- vitest run",
    "test:audit": "node scripts/testing/audit-test-suite.mjs",
    "test:architecture": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs architecture",
    "test:unit": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs unit",
    "test:functional": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs functional",
    "test:regression": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/run-test-group.mjs regression",
    "test:coverage": "node scripts/testing/run-resource-safe.mjs -- vitest run --config tests/config/vitest.coverage.config.ts",
    "test:watch": "node scripts/testing/run-resource-safe.mjs -- vitest",
    "postinstall": "wxt prepare",
    "analyze:bundle": "node scripts/testing/run-resource-safe.mjs -- node scripts/testing/analyze-bundle-size.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.87",
    "@ctrl/tinycolor": "3.6.1",
    "@element-plus/icons-vue": "^2.3.1",
    "@noble/hashes": "1.8.0",
    "@wxt-dev/storage": "^1.0.1",
    "ai": "7.0.165",
    "defuddle": "^0.19.6",
    "dexie": "^4.4.7",
    "element-plus": "^2.9.3",
    "entities": "4.5.0",
    "franc-min": "^6.2.0",
    "tldts": "^7.4.19",
    "turndown": "7.2.4",
    "webextension-polyfill": "^0.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.0",
    "@types/node": "^22.19.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.0.0",
    "linkedom": "0.18.12",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "3.3.13",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82d547ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
